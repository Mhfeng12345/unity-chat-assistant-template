--- !u!114 &5025736374302102209
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6540891427902559901}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b3af6f95d76c8c4aa2982fb066f14a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  contentText: {fileID: 8459449094893185475}
  textJson: "{\r\n  \"\u6570\u636E\u7248\u672C\": 2,\r\n  \"\u5B9E\u9A8C\u6A21\u5757\":
    \"\u69FD\u5F0F\u573A\u666F\u6F2B\u6E38DCS\",\r\n  \"\u5B9E\u9A8C\u6279\u6B21\":
    \"RW17\",\r\n  \"\u672C\u6279\u6B21\u5206\u6790\u5E8F\u53F7\": 2,\r\n  \"\u91C7\u96C6\u4FE1\u606F\":
    {\r\n    \"\u5FEB\u7167\u8DDD\u5F53\u524D\uFF08\u79D2\uFF09\": 0,\r\n    \"\u662F\u5426\u6682\u505C\u7F13\u5B58\":
    false,\r\n    \"\u662F\u5426\u8DE8\u4EFF\u771F\u6B65\u6DF7\u5408\": false,\r\n   
    \"\u662F\u5426\u91CD\u7F6E\": false\r\n  },\r\n  \"\u5F53\u524D\u72B6\u6001\":
    {\r\n    \"\u8FD0\u884C\u72B6\u6001\": {\r\n      \"\u6B63\u5728\u8FD0\u884C\":
    true\r\n    },\r\n    \"\u73AF\u5883\u5DE5\u51B5\": {\r\n      \"\u8BBE\u5B9A\u5C0F\u65F6\uFF08h\uFF09\":
    12,\r\n      \"\u73AF\u5883\u6E29\u5EA6\uFF08\u2103\uFF09\": 25,\r\n      \"\u592A\u9633\u8F90\u7167\u5EA6\uFF08W/m\xB2\uFF09\":
    800\r\n    },\r\n    \"\u69FD\u5F0F\u96C6\u70ED\u573A\": {\r\n      \"\u5DE5\u4F5C\u69FD\u6570\u91CF\uFF08\u53F0\uFF09\":
    160,\r\n      \"\u53CD\u5C04\u7387\uFF080\u81F31\uFF09\": 0.75,\r\n      \"\u96C6\u70ED\u5668\u6E29\u5EA6\uFF08\u2103\uFF09\":
    320.0\r\n    },\r\n    \"\u51B7\u70ED\u76D0\u7F50\": {\r\n      \"\u70ED\u76D0\u6E29\u5EA6\uFF08\u2103\uFF09\":
    500,\r\n      \"\u51B7\u76D0\u6E29\u5EA6\uFF08\u2103\uFF09\": 300\r\n    },\r\n   
    \"\u7ED9\u6C34\u4E0E\u84B8\u6C7D\": {\r\n      \"\u7ED9\u6C34\u6D41\u91CF\uFF08t/h\uFF09\":
    25,\r\n      \"\u7ED9\u6C34\u6E29\u5EA6\uFF08\u2103\uFF09\": 180,\r\n      \"\u51FA\u53E3\u84B8\u6C7D\u6E29\u5EA6\uFF08\u2103\uFF09\":
    450,\r\n      \"\u51FA\u53E3\u84B8\u6C7D\u538B\u529B\uFF08MPa\uFF09\": 8\r\n   
    },\r\n    \"\u6C7D\u8F6E\u53D1\u7535\": {\r\n      \"\u53D1\u7535\u529F\u7387\u4E0A\u9650\u8BBE\u5B9A\uFF08MW\u7535\uFF09\":
    3,\r\n      \"\u6C7D\u8F6E\u673A\u8F6C\u901F\uFF08rpm\uFF09\": 3000,\r\n     
    \"\u6709\u529F\u53D1\u7535\u529F\u7387\uFF08MW\u7535\uFF09\": 0.6\r\n    },\r\n   
    \"\u6CF5\u4E0E\u51B7\u5374\u8BBE\u5B9A\": {\r\n      \"\u7194\u76D0\u6CF5\u6D41\u91CF\u8BBE\u5B9A\uFF08t/h\uFF09\":
    60,\r\n      \"\u7194\u76D0\u6CF5\u626C\u7A0B\u8BBE\u5B9A\uFF08m\uFF09\": 30,\r\n     
    \"\u51B7\u5374\u6C34\u6D41\u91CF\u8BBE\u5B9A\uFF08t/h\uFF09\": 300,\r\n     
    \"\u51B7\u5374\u6C34\u6E29\u5EA6\u8BBE\u5B9A\uFF08\u2103\uFF09\": 25,\r\n     
    \"\u98CE\u673A\u8F6C\u901F\u8BBE\u5B9A\uFF08rpm\uFF09\": 500\r\n    },\r\n   
    \"\u7535\u529B\u9700\u6C42\": {\r\n      \"\u7535\u8D1F\u8377\u9700\u6C42\uFF08MW\u7535\uFF09\":
    0.4656\r\n    },\r\n    \"\u73B0\u6709\u62A5\u8B66\": {\r\n      \"\u62A5\u8B66\u6D88\u606F\":
    []\r\n    }\r\n  },\r\n  \"\u4E0E\u4E0A\u6B21\u70B9\u51FB\u76F8\u6BD4\": {\r\n   
    \"\u4E0A\u6B21\u5206\u6790\u5E8F\u53F7\": 1,\r\n    \"\u53C2\u6570\u6216\u8F93\u51FA\u53D8\u5316\":
    [\r\n      {\"\u9879\u76EE\": \"\u6CF5\u4E0E\u51B7\u5374\u8BBE\u5B9A.\u98CE\u673A\u8F6C\u901F\u8BBE\u5B9A\uFF08rpm\uFF09\",
    \"\u4E0A\u6B21\u503C\": 1000, \"\u672C\u6B21\u503C\": 500}\r\n    ],\r\n    \"\u672A\u5C55\u5F00\u53D8\u5316\u6570\u91CF\":
    0\r\n  },\r\n  \"\u8F85\u52A9\u8BA1\u7B97\": {\r\n    \"\u53E3\u5F84\": \"\u6309\u6240\u62A5\u539F\u503C\u53EA\u8BFB\u8BA1\u7B97\uFF0C\u975E\u989D\u5916\u6D4B\u91CF\uFF1B\u5148\u6838\u5BF9\u6E90\u6570\u636E\u4E0E\u5355\u4F4D\",\r\n   
    \"\u5F53\u524D\u4F9B\u7535\u7F3A\u53E3\uFF08MW\u7535\uFF09\": 0,\r\n    \"\u5F53\u524D\u53D1\u7535\u5BCC\u4F59\uFF08MW\u7535\uFF09\":
    0.1344,\r\n    \"\u4F9B\u7ED9\u5360\u9700\u6C42\u6BD4\u4F8B\uFF08%\uFF09\": 128.87,\r\n   
    \"\u7B80\u5316\u516C\u5F0F\u53D1\u7535\u57FA\u51C6\uFF08MW\u7535\uFF09\": 0.6,\r\n   
    \"\u6240\u62A5\u53D1\u7535\u51CF\u57FA\u51C6\uFF08MW\u7535\uFF09\": 0.0,\r\n   
    \"\u70ED\u76D0\u51CF\u51B7\u76D0\u6E29\u5DEE\uFF08\u2103\uFF09\": 200\r\n  }\r\n}\r\n"
