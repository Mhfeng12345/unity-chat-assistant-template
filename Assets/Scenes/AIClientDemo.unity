  chatStr: 
  experimentDataJson: "{\n  \"experiment_data\": {\n    \"experiment_name\": \"\u7535\u673A\u4E0E\u62D6\u52A8\u77E5\u8BC6\u6784\u5EFA\u53CA\u6570\u5B57\u5B6A\u751F\u5C55\u793A\u7CFB\u7EDF\",\n   
